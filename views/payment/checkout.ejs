<%- include('../partials/header') %>

<div class="container" style="max-width:700px;padding:40px 20px;">
  <div class="card">
    <div class="card-header" style="font-size:1.3rem;">
      <i class="fas fa-shopping-cart" style="color:var(--primary);"></i> Satın Al
    </div>
    <div class="card-body">
      <% if (error) { %>
        <div class="alert alert-danger">
          <i class="fas fa-exclamation-circle"></i>
          <% if (error === 'insufficient_balance') { %>
            Yetersiz bakiye. <a href="/bakiye/yukle" style="color:inherit;font-weight:bold;">Bakiye yüklemek için tıklayın.</a>
          <% } else if (error === 'own_listing') { %>
            Kendi ilanınızı satın alamazsınız.
          <% } else { %><%= error %><% } %>
        </div>
      <% } %>

      <!-- Listing Summary -->
      <div style="background:#f8f8f8;border-radius:12px;padding:20px;margin-bottom:24px;">
        <div style="font-size:0.8rem;color:#888;margin-bottom:4px;text-transform:uppercase;letter-spacing:0.5px;">Satın Alınacak İlan</div>
        <div style="font-weight:700;font-size:1.1rem;margin-bottom:8px;"><%= listing.title %></div>
        <div style="display:flex;justify-content:space-between;align-items:center;">
          <span style="color:#888;font-size:0.9rem;">Satıcı: <strong><%= listing.seller_username %></strong></span>
          <span class="badge badge-yellow"><%= listing.category_name || 'Dijital' %></span>
        </div>
      </div>

      <!-- Price Summary -->
      <div style="background:white;border:1px solid #e0e0e0;border-radius:12px;overflow:hidden;margin-bottom:24px;">
        <div style="display:flex;justify-content:space-between;padding:14px 16px;border-bottom:1px solid #f0f0f0;">
          <span style="color:#666;">İlan Fiyatı</span>
          <span style="font-weight:600;">₺<%= parseFloat(listing.price).toLocaleString('tr-TR', {minimumFractionDigits:2}) %></span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:14px 16px;border-bottom:1px solid #f0f0f0;">
          <span style="color:#666;">Platform Komisyonu (%<%= ((fee/listing.price)*100).toFixed(0) %>)</span>
          <span style="font-weight:600;color:#888;">₺<%= parseFloat(fee).toLocaleString('tr-TR', {minimumFractionDigits:2}) %></span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:16px;background:#f8f8f8;">
          <span style="font-weight:800;font-size:1.1rem;">TOPLAM</span>
          <span style="font-weight:900;font-size:1.3rem;color:var(--dark);">₺<%= parseFloat(total).toLocaleString('tr-TR', {minimumFractionDigits:2}) %></span>
        </div>
      </div>

      <!-- Bakiye ile Öde -->
      <div style="margin-bottom:24px;">
        <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:16px;">💳 Ödeme Yöntemi</h3>
        
        <!-- Balance Payment -->
        <div style="border:2px solid var(--primary);border-radius:12px;padding:20px;margin-bottom:16px;">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
            <div>
              <div style="font-weight:700;">💰 Bakiye ile Öde</div>
              <div style="font-size:0.85rem;color:#888;">Mevcut Bakiye: <strong style="color:<%= userBalance >= total ? 'var(--success)' : 'var(--danger)' %>">₺<%= parseFloat(userBalance || 0).toFixed(2) %></strong></div>
            </div>
            <% if (userBalance >= total) { %>
              <span class="badge badge-green">Yeterli Bakiye</span>
            <% } else { %>
              <span class="badge badge-red">Yetersiz Bakiye</span>
            <% } %>
          </div>
          
          <% if (userBalance >= total) { %>
            <form action="/odeme/<%= listing.uuid %>/bakiye" method="POST" onsubmit="return confirm('₺<%= parseFloat(total).toFixed(2) %> tutarında ödeme yapılacak. Onaylıyor musunuz?')">
              <button type="submit" class="btn btn-primary btn-full btn-lg">
                <i class="fas fa-check-circle"></i> Bakiyemle Satın Al
              </button>
            </form>
          <% } else { %>
            <a href="/bakiye/yukle" class="btn btn-dark btn-full">
              <i class="fas fa-plus"></i> Bakiye Yükle (₺<%= (total - userBalance).toFixed(2) %> eksik)
            </a>
          <% } %>
        </div>

        <!-- Card Payment (Demo) -->
        <div style="border:1px solid #e0e0e0;border-radius:12px;padding:20px;background:#f9f9f9;">
          <div style="font-weight:700;margin-bottom:4px;">💳 Kredi/Banka Kartı</div>
          <div style="font-size:0.8rem;color:#888;margin-bottom:16px;">Kart bilgilerinizi girerek bakiye yükleyip ödeme yapabilirsiniz.</div>
          <a href="/bakiye/yukle?amount=<%= Math.ceil(total) %>" class="btn btn-outline btn-full">
            <i class="fas fa-credit-card"></i> Kart ile Bakiye Yükle
          </a>
        </div>
      </div>

      <!-- Safety Note -->
      <div style="background:#f0fff4;border:1px solid #c3e6cb;border-radius:8px;padding:14px;font-size:0.85rem;color:#155724;">
        <i class="fas fa-shield-alt"></i>
        <strong>Güvenli Ödeme:</strong> Ödemeniz güvence altında tutulur. Ürünü teslim aldıktan sonra satıcıya aktarılır.
      </div>

      <div style="margin-top:16px;">
        <a href="/ilanlar/<%= listing.uuid %>" class="btn btn-outline btn-sm">
          <i class="fas fa-arrow-left"></i> İlana Dön
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
