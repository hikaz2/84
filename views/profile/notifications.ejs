<%- include('../partials/header') %>

<div class="container" style="padding:40px 20px;max-width:800px;">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;">
    <h1 style="font-size:1.6rem;font-weight:800;">🔔 Bildirimlerim</h1>
    <span style="font-size:0.85rem;color:#888;"><%= notifications.length %> bildirim</span>
  </div>

  <% if (notifications.length === 0) { %>
    <div style="text-align:center;padding:80px;background:white;border-radius:16px;border:1px solid #e0e0e0;">
      <i class="fas fa-bell-slash" style="font-size:3rem;color:#ddd;margin-bottom:16px;display:block;"></i>
      <h3 style="color:#666;">Bildirim yok</h3>
    </div>
  <% } else { %>
    <div class="card">
      <% notifications.forEach(notif => { %>
      <div style="display:flex;gap:16px;padding:16px 20px;border-bottom:1px solid #f0f0f0;<%= !notif.is_read ? 'background:#fffbf0;' : '' %>">
        <div style="font-size:1.5rem;flex-shrink:0;">
          <% const icons = {welcome:'🎉',message:'💬',purchase:'🛒',sale:'💸',listing:'📋',balance:'💰',default:'🔔'}; %>
          <%= icons[notif.type] || icons.default %>
        </div>
        <div style="flex:1;">
          <div style="font-weight:700;font-size:0.9rem;margin-bottom:2px;"><%= notif.title %></div>
          <p style="color:#555;font-size:0.85rem;"><%= notif.message %></p>
          <div style="display:flex;align-items:center;gap:12px;margin-top:6px;">
            <span style="font-size:0.75rem;color:#999;"><%= new Date(notif.created_at).toLocaleString('tr-TR') %></span>
            <% if (notif.link) { %>
              <a href="<%= notif.link %>" style="font-size:0.8rem;color:var(--primary);font-weight:600;">Görüntüle →</a>
            <% } %>
          </div>
        </div>
        <% if (!notif.is_read) { %>
          <div style="width:8px;height:8px;border-radius:50%;background:var(--primary);margin-top:6px;flex-shrink:0;"></div>
        <% } %>
      </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
