<%- include('../partials/header') %>

<div class="container" style="max-width:700px;padding:40px 20px;">
  <div class="card">
    <div class="card-header">
      <i class="fas fa-user-edit" style="color:var(--primary);"></i> Profili Düzenle
    </div>
    <div class="card-body">
      <% if (error) { %>
        <div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="alert alert-success alert-auto-dismiss"><i class="fas fa-check-circle"></i> <%= success %></div>
      <% } %>

      <form action="/profil/duzenle" method="POST" enctype="multipart/form-data">
        <div style="text-align:center;margin-bottom:28px;">
          <div style="width:90px;height:90px;border-radius:50%;background:var(--primary);display:flex;align-items:center;justify-content:center;font-size:2rem;font-weight:900;color:#111;margin:0 auto 12px;">
            <%= user.username.charAt(0).toUpperCase() %>
          </div>
          <label class="btn btn-outline btn-sm" style="cursor:pointer;">
            <i class="fas fa-camera"></i> Fotoğraf Değiştir
            <input type="file" name="avatar" accept="image/jpeg,image/png,image/webp" style="display:none;" onchange="document.getElementById('avatarName').textContent=this.files[0]?.name||''">
          </label>
          <div id="avatarName" style="font-size:0.75rem;color:#888;margin-top:4px;"></div>
        </div>

        <div class="form-group">
          <label class="form-label">Kullanıcı Adı</label>
          <input type="text" class="form-control" value="<%= user.username %>" disabled style="background:#f8f8f8;color:#888;">
          <div class="form-hint">Kullanıcı adı değiştirilemez.</div>
        </div>

        <div class="form-group">
          <label class="form-label">E-posta</label>
          <input type="email" class="form-control" value="<%= user.email %>" disabled style="background:#f8f8f8;color:#888;">
        </div>

        <div class="form-group">
          <label class="form-label">Hakkımda</label>
          <textarea name="bio" class="form-control" rows="4" placeholder="Kendinizi tanıtın..." maxlength="500" data-maxlength="500"><%= user.bio || '' %></textarea>
        </div>

        <div class="form-group">
          <label class="form-label">Telefon</label>
          <input type="text" name="phone" class="form-control" placeholder="+90 555 000 00 00" value="<%= user.phone || '' %>">
        </div>

        <div class="divider"></div>

        <h3 style="font-size:1rem;font-weight:700;margin-bottom:16px;">🔒 Şifre Değiştir</h3>
        <div class="form-group">
          <label class="form-label">Mevcut Şifre</label>
          <input type="password" name="current_password" class="form-control" placeholder="Mevcut şifreniz">
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
          <div class="form-group">
            <label class="form-label">Yeni Şifre</label>
            <input type="password" name="new_password" class="form-control" placeholder="Yeni şifre" minlength="6">
          </div>
          <div class="form-group">
            <label class="form-label">Yeni Şifre Tekrar</label>
            <input type="password" name="new_password2" class="form-control" placeholder="Tekrar girin" minlength="6">
          </div>
        </div>

        <div style="display:flex;gap:12px;">
          <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Kaydet</button>
          <a href="/profil" class="btn btn-outline">İptal</a>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
