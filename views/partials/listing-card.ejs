<a href="/ilanlar/<%= listing.uuid %>" class="listing-card" style="display:block;">
  <% const images = typeof listing.images === 'string' ? JSON.parse(listing.images || '[]') : (listing.images || []); %>
  
  <% if (listing.is_featured) { %>
    <span class="badge-featured">⭐ Öne Çıkan</span>
  <% } %>

  <div class="card-image">
    <% if (images.length > 0) { %>
      <img src="<%= images[0] %>" alt="<%= listing.title %>" style="width:100%;height:100%;object-fit:cover;">
    <% } else { %>
      <span style="font-size:3.5rem;opacity:0.5;">🎮</span>
    <% } %>
  </div>
  
  <div class="card-body">
    <div class="card-category"><%= listing.category_name %></div>
    <div class="card-title"><%= listing.title %></div>
    <div style="display:flex;align-items:center;gap:6px;font-size:0.8rem;color:#888;">
      <i class="fas fa-eye"></i> <%= listing.view_count %> görüntülenme
    </div>
  </div>
  
  <div class="card-footer">
    <div class="card-price">₺<%= parseFloat(listing.price).toLocaleString('tr-TR') %></div>
    <div class="card-seller">
      <i class="fas fa-user-circle"></i> <%= listing.username %>
    </div>
  </div>
</a>
