<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | <%= siteName %></title>
  <meta name="description" content="HesapSat - Türkiye'nin en güvenilir dijital hesap ve ürün pazaryeri">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    /* Inline critical CSS for speed */
    * { box-sizing: border-box; }
  </style>
</head>
<body>

<!-- NAVIGATION -->
<nav class="navbar">
  <div class="container">
    <a href="/" class="navbar-brand">Hesap<span>Sat</span></a>

    <div class="navbar-search">
      <form action="/ara" method="GET">
        <input type="text" name="q" placeholder="İlan ara..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
        <button type="submit"><i class="fas fa-search"></i></button>
      </form>
    </div>

    <nav class="navbar-nav">
      <a href="/ilanlar" class="nav-link <%= currentPath.startsWith('/ilanlar') ? 'active' : '' %>">
        <i class="fas fa-list"></i> İlanlar
      </a>

      <% if (user) { %>
        <a href="/mesajlar" class="nav-link">
          <i class="fas fa-envelope"></i>
          <% if (locals.unreadMessages > 0) { %>
            <span class="nav-badge"><%= locals.unreadMessages %></span>
          <% } %>
        </a>

        <a href="/profil/bildirimler" class="nav-link">
          <i class="fas fa-bell"></i>
          <% if (locals.unreadNotifications > 0) { %>
            <span class="nav-badge"><%= locals.unreadNotifications %></span>
          <% } %>
        </a>

        <div class="dropdown">
          <a href="#" class="nav-link" data-toggle="dropdown" style="display:flex;align-items:center;gap:8px;">
            <% if (user.avatar) { %>
              <img src="<%= user.avatar %>" class="avatar" alt="">
            <% } else { %>
              <div class="avatar-placeholder"><%= user.username.charAt(0).toUpperCase() %></div>
            <% } %>
            <span><%= user.username %></span>
            <i class="fas fa-chevron-down" style="font-size:0.7rem;"></i>
          </a>
          <div class="dropdown-menu">
            <div style="padding:12px 16px;border-bottom:1px solid #f0f0f0;">
              <div style="font-weight:700;"><%= user.username %></div>
              <div style="font-size:0.8rem;color:#888;">Bakiye: <strong style="color:#333;">₺<%= parseFloat(user.balance || 0).toFixed(2) %></strong></div>
            </div>
            <a href="/profil" class="dropdown-item"><i class="fas fa-user"></i> Profilim</a>
            <a href="/profil/ilanlarim" class="dropdown-item"><i class="fas fa-list"></i> İlanlarım</a>
            <a href="/profil/favorilerim" class="dropdown-item"><i class="fas fa-heart"></i> Favorilerim</a>
            <a href="/profil/islemler" class="dropdown-item"><i class="fas fa-exchange-alt"></i> İşlemlerim</a>
            <a href="/bakiye/yukle" class="dropdown-item"><i class="fas fa-wallet"></i> Bakiye Yükle</a>
            <% if (user.role === 'admin' || user.role === 'moderator') { %>
              <div class="dropdown-divider"></div>
              <a href="/admin" class="dropdown-item"><i class="fas fa-cogs"></i> Yönetici Paneli</a>
            <% } %>
            <div class="dropdown-divider"></div>
            <a href="/profil/duzenle" class="dropdown-item"><i class="fas fa-edit"></i> Ayarlar</a>
            <a href="/cikis" class="dropdown-item" style="color:var(--danger);"><i class="fas fa-sign-out-alt"></i> Çıkış Yap</a>
          </div>
        </div>

        <a href="/ilanlar/yeni/ekle" class="btn btn-primary-nav">
          <i class="fas fa-plus"></i> İlan Ver
        </a>
      <% } else { %>
        <a href="/giris" class="nav-link">Giriş Yap</a>
        <a href="/kayit" class="btn btn-primary-nav">Üye Ol</a>
      <% } %>
    </nav>
  </div>
</nav>
