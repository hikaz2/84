PORT=3000
NODE_ENV=development

# JWT Secret (change this in production!)
JWT_SECRET=your_super_secret_jwt_key_change_in_production_123456

# Session Secret (change this in production!)
SESSION_SECRET=your_super_secret_session_key_change_in_production_123456

# Database path
DB_PATH=./database/marketplace.db

# Upload directory
UPLOAD_DIR=./public/uploads

# Admin credentials (initial setup)
ADMIN_EMAIL=admin@hesapsat.net
ADMIN_PASSWORD=Admin123!

# Stripe payment (optional - for real payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here

# Site configuration
SITE_NAME=HesapSat
SITE_URL=http://localhost:3000
